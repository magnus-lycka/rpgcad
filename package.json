{
  "name": "rpgcad",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check prototype/*.js prototype/index.html tests/*.js *.mjs *.json .github/**/*.yml",
    "format": "prettier --write prototype/*.js prototype/index.html tests/*.js *.mjs *.json .github/**/*.yml",
    "typecheck": "tsc --noEmit",
    "dependencies:check": "knip",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run dependencies:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
