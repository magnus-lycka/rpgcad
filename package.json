{
  "name": "rpgcad",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check prototype/*.js prototype/*.html prototype/component-catalogue.json \"tests/**/*.js\" *.mjs *.json .github/**/*.yml tests/fixtures/*.json \"docs/**/*.md\"",
    "format": "prettier --write prototype/*.js prototype/*.html prototype/component-catalogue.json \"tests/**/*.js\" *.mjs *.json .github/**/*.yml tests/fixtures/*.json \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit",
    "dependencies:check": "knip",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run dependencies:check && npm test && npm run test:browser",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "knip": "^6.40.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
